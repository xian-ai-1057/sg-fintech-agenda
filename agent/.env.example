# 複製成 agent/.env 後填入。這個檔不會進版控（見 .gitignore）。
OPENAI_API_KEY=sk-...

# 模型 id 會換。遇到 "model not found" 就把這兩行改成你帳號可用的 model。
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBED_MODEL=text-embedding-3-small

# 走 OpenAI 相容端點（自架 vLLM、公司內部閘道…）時才需要這一行，chat 與 embedding 共用。
# 這種端點通常不驗金鑰，OPENAI_API_KEY 隨便填一個非空字串即可（例如 EMPTY）。
# OPENAI_BASE_URL=http://<你的主機>:<port>/v1

# index.html 的對話框要連 agent/api.py 時，若網頁不是從本機開的（例如 GitHub Pages），
# 要在這裡把它的來源加進白名單，逗號分隔。本機來源預設就通，不必寫。
# SFF_AGENT_ORIGINS=https://xian-ai-1057.github.io
